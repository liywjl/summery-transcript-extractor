{
  "manifest_version": 3,
  "name": "Summery",
  "description": "Copy a YouTube transcript or a page's main text as a ready-to-paste chat prompt.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Summery",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "offscreen", "clipboardWrite", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://www.youtube.com/*"]
}
